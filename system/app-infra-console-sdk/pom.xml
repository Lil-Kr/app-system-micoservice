<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.cy.micoservice.app</groupId>
		<artifactId>system</artifactId>
		<version>1.0.0</version>
	</parent>
	
	<artifactId>app-infra-console-sdk</artifactId>
	<packaging>jar</packaging>
	
	<properties>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<app-framework-parent.version>1.0.0</app-framework-parent.version>
		<app-common.version>1.0.0</app-common.version>
		<app-gateway-facade.version>1.0.0</app-gateway-facade.version>
		<app-infra-console-facade.version>1.0.0</app-infra-console-facade.version>
		<app-gateway-model.version>1.0.0</app-gateway-model.version>
	</properties>
	
	<dependencies>
		<!-- OpenFeign 核心 -->
		<dependency>
			<groupId>io.github.openfeign</groupId>
			<artifactId>feign-core</artifactId>
			<version>12.4</version>
		</dependency>
		
		<!-- JSON 序列化/反序列化(可选, 这里用 Jackson) -->
		<dependency>
			<groupId>io.github.openfeign</groupId>
			<artifactId>feign-jackson</artifactId>
			<version>12.4</version>
		</dependency>
		
		<!-- Nacos 客户端 -->
		<dependency>
			<groupId>com.alibaba.nacos</groupId>
			<artifactId>nacos-client</artifactId>
			<version>2.2.3</version>
		</dependency>
		
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
		
		<!-- 自定义组件 -->
		<dependency>
			<groupId>org.cy.micoservice.app</groupId>
			<artifactId>app-framework-web-starter</artifactId>
			<version>${app-framework-parent.version}</version>
			<optional>true</optional>
		</dependency>
		
		<dependency>
			<groupId>org.cy.micoservice.app</groupId>
			<artifactId>app-common</artifactId>
			<version>${app-common.version}</version>
			<optional>true</optional>
		</dependency>
		
		<dependency>
			<groupId>org.cy.micoservice.app</groupId>
			<artifactId>app-infra-console-facade</artifactId>
			<version>${app-infra-console-facade.version}</version>
		</dependency>
	</dependencies>
	
</project>
